{
  "name": "run-and-notify",
  "version": "0.3.0",
  "description": "Execute a command and send the notification results via better-notify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barbieri/run-and-notify.git"
  },
  "type": "module",
  "private": false,
  "license": "GPL-3.0-or-later",
  "keywords": [
    "cli",
    "notifications",
    "slack",
    "email",
    "automation",
    "monitoring",
    "run-and-notify"
  ],
  "engines": {
    "node": ">=26.4.0",
    "pnpm": ">=12.18.0"
  },
  "packageManager": "pnpm@12.18.0",
  "files": [
    "dist/bundle",
    "schemas",
    "examples",
    "config.example.json",
    ".env.example",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "run-and-notify": "dist/bundle/run-and-notify.mjs"
  },
  "scripts": {
    "build": "tsc && node scripts/build-cli.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write --error-on-warnings .",
    "format": "biome format --write .",
    "lint": "biome lint --error-on-warnings .",
    "qa": "run-p check build test typecheck",
    "run-and-notify": "node --import tsx src/run-and-notify.ts",
    "run-and-notify:bundle": "node dist/bundle/run-and-notify.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@betternotify/core": "1.0.0-beta.12",
    "@betternotify/email": "1.0.0-beta.8",
    "@betternotify/slack": "1.0.0-beta.8",
    "@betternotify/smtp": "1.0.0-beta.7",
    "@biomejs/biome": "^2.6.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "8.20.0",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "handlebars": "^4.7.10",
    "husky": "^9.1.7",
    "lodash": "^4.18.1",
    "markdown-to-slack-blocks": "^1.6.1",
    "marked": "^18.1.3",
    "npm-run-all": "^4.1.5",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "turndown": "^7.2.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "yargs": "^18.2.0"
  }
}
