{{~#if (eq format "raw")~}}
<pre style="white-space: pre-wrap; background: var(--surface-sunken); color: var(--text); border-radius: 12px; padding: 14px 16px; overflow-x: auto;">{{{rawToHtml raw}}}</pre>
{{~/if~}}
{{~#if (eq format "markdown")~}}
{{{markdownToHtml markdown}}}
{{~/if~}}
{{~#if (eq format "html")~}}
{{{html}}}
{{~/if~}}
{{~#if (eq format "jsonl")~}}
<div style="display: grid; gap: 12px;">{{#each lines}}<article style="border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; background: var(--surface-raised);"><dl style="margin: 0; display: grid; gap: 8px;">{{#each this}}<div><dt style="font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); font-weight: 700;">{{@key}}</dt><dd style="margin: 2px 0 0; color: var(--text);">{{jsonValue this}}</dd></div>{{/each}}</dl></article>{{/each}}</div>
{{~/if~}}
{{~#if (eq format "pino")~}}
<div style="display: grid; gap: 12px;">{{#each lines}}<article style="border: 1px solid var(--border); border-left: 6px solid {{pinoLevelColor level}}; border-radius: 12px; padding: 14px 16px; background: var(--surface-raised);"><p style="margin: 0 0 8px; font-weight: 700; color: {{pinoLevelColor level}}; text-transform: uppercase;">{{pinoLevelLabel level}}</p><p style="margin: 0 0 10px; color: var(--text);">{{pinoMessage this}}</p><dl style="margin: 0; display: grid; gap: 6px;">{{#if (pinoTime this)}}<div><dt style="font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); font-weight: 700;">time</dt><dd style="margin: 2px 0 0; color: var(--text);">{{datetimeFromUnixEpochMilliseconds (pinoTime this)}}</dd></div>{{/if}}{{#if pid}}<div><dt style="font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); font-weight: 700;">pid</dt><dd style="margin: 2px 0 0; color: var(--text);">{{jsonValue pid}}</dd></div>{{/if}}{{#if hostname}}<div><dt style="font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); font-weight: 700;">hostname</dt><dd style="margin: 2px 0 0; color: var(--text);">{{jsonValue hostname}}</dd></div>{{/if}}{{#each (pinoFields this)}}<div style="margin-left: 16px;"><dt style="font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); font-weight: 700;">{{@key}}</dt><dd style="margin: 2px 0 0; color: var(--text);">{{jsonValue this}}</dd></div>{{/each}}</dl></article>{{/each}}</div>
{{~/if~}}{{nl~}}
