{{~#if (eq format "raw")~}}
<pre style="white-space: pre-wrap; background: var(--surface-sunken); color: var(--text); border-radius: 12px; padding: 14px 16px; overflow-x: auto;">{{{rawToHtml raw}}}</pre>
{{~/if~}}
{{~#if (eq format "markdown")~}}
{{{markdownToHtml markdown}}}
{{~/if~}}
{{~#if (eq format "html")~}}
{{{html}}}
{{~/if~}}
{{~#if (lookup this "lines")~}}
<div style="display: grid; gap: 12px;">{{#each (structuredLines this)}}<article style="border: 1px solid var(--border);{{#if isLog}} border-left: 6px solid {{levelColor}};{{/if}} border-radius: 12px; padding: 14px 16px; background: var(--surface-raised);">{{#if isLog}}<p style="margin: 0 0 8px; font-weight: 700; color: {{levelColor}}; text-transform: uppercase;">{{levelLabel}}</p><p style="margin: 0 0 10px; color: var(--text); white-space: pre-wrap;">{{message}}</p>{{/if}}<dl style="margin: 0; display: grid; gap: 8px;">{{#if timestamp}}<div><dt style="font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); font-weight: 700;">{{timestamp.key}}</dt><dd style="margin: 2px 0 0; color: var(--text); white-space: pre-wrap;">{{timestamp.value}}</dd></div>{{/if}}{{#each fields}}<div><dt style="font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); font-weight: 700;">{{key}}</dt><dd style="margin: 2px 0 0; color: var(--text); white-space: pre-wrap;">{{value}}</dd></div>{{/each}}</dl></article>{{/each}}</div>
{{~/if~}}{{nl~}}
